# .gitignore - ignore private keys and accidental ssh-agent output files

# Ignore private keys and certificates
id_rsa
id_dsa
id_ecdsa
id_ed25519
id_*
*.pem
*.key
*.ppk

# Ignore SSH folders and common key directories
.ssh/
ssh_keys/
private_keys/

# Ignore public keys (optional). Public keys are not secrets but you may still not want them in the repo
*.pub

# Ignore any filename containing "ssh-agent" (covers odd filenames produced by accidental redirects)
*ssh-agent*

# Specific odd filenames you provided (literal names)
# These lines will match files literally named:
#   eval "$(ssh-agent -s)"
#   eval "$(ssh-agent -s)".pub
eval "$(ssh-agent -s)"
eval "$(ssh-agent -s)".pub
